# Copy to .env.local and fill in. Never commit real values, never paste them in a chat.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only (bypasses RLS): team accounts, payment webhook and the daily job.
SUPABASE_SERVICE_ROLE_KEY=
# Payments: Stripe Checkout. Use sk_test_ keys until the shop is ready to open.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Daily job (/api/cron/diario): any long random string; the scheduler sends it as "Bearer <secret>".
CRON_SECRET=
# Obsidian vault folder (the one with .obsidian/). Default: two levels above this app.
VAULT_PATH=
